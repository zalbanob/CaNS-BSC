&dns
ng(1:3) = 375, 3250, 1200
l(1:3) = 20., 100., 60.
gtype = 2, gr = 2.3.
at=0.
is_fringe= T, fringe_frac=0.97
cfl = 0.95, dtmax = 1.e9, dt_f = 0.042
visci = 2500.
inivel = 'bla'
is_wallturb = F
nstep = 10, time_max = 100., tw_max = 0.1
stop_type(1:3) = T, F, F
restart = F, is_overwrite_save = F, nsaves_max = 0
icheck = 10, iout0d = 0, iout1d = 0, iout2d = 0, iout3d = 0, isave = 0, is_simple_writing=.true.
cbcvel(0:1,1:3,1) = 'B','A',  'P','P',  'D','N'
cbcvel(0:1,1:3,2) = 'D','N',  'P','P',  'D','N'
cbcvel(0:1,1:3,3) = 'D','N',  'P','P',  'D','N'
cbcpre(0:1,1:3)   = 'N','N',  'P','P',  'N','D'
bcvel(0:1,1:3,1) =  0.,0.,   0.,0.,   0.,0.
bcvel(0:1,1:3,2) =  0.,0.,   0.,0.,   0.,0.
bcvel(0:1,1:3,3) =  0.,0.,   0.,0.,   0.,0.
bcpre(0:1,1:3)   =  0.,0.,   0.,0.,   0.,0.
bforce(1:3) = 0., 0., 0.
is_forced(1:3) = F, F, F
velf(1:3) = 0., 0., 0.
dims(1:2) = 1, 4, ipencil_axis =3
/

&cudecomp
cudecomp_t_comm_backend = 4, cudecomp_is_t_enable_nccl = T, cudecomp_is_t_enable_nvshmem = T
cudecomp_h_comm_backend = 1, cudecomp_is_h_enable_nccl = F, cudecomp_is_h_enable_nvshmem = T
/

&numerics
is_impdiff = T, is_impdiff_1d = T
is_poisson_pcr_tdma = F
/

&save_inlet
is_inlet_record=F, is_inlet_replay=F
ix0=15831,
save_freq=500,
read_freq=500, istart=1
/

&save_crop
iout3dcrop=0,
imin=1,imax=1071,jmin=1450,jmax=1750,kmin=1,kmax=800
/
&other_options
is_debug = F, is_timing = T
/


